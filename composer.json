{
    "name": "timatic/jsonapi-sdk-generator",
    "description": "Generate PHP SDKs from OpenAPI specifications for JSON:API endpoints",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../saloon-sdk-generator"
        }
    ],
    "autoload": {
        "psr-4": {
            "Timatic\\JsonApiSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Timatic\\JsonApiSdk\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.0",
        "timatic/saloon-sdk-generator": "dev-main",
        "saloonphp/pagination-plugin": "^2.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "fakerphp/faker": "^1.23",
        "phpstan/phpstan": "^2.1"
    },

    "bin": ["bin/jsonapi-sdk"],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse --memory-limit=2G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
